# Segredos de implantação: nunca inclua o .env no GitHub
POSTGRES_DB=zabbix_dashboard
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-this-long-password
ADMIN_PASSWORD=change-this-admin-password
# Set true when publishing through HTTPS. Keep false for local HTTP.
SESSION_COOKIE_SECURE=false
FLASK_SECRET_KEY=change-this-long-random-secret
FERNET_KEY=

# Configuração da integração Zabbix.
# Endpoint corporativo público, configurável neste arquivo.
ZABBIX_URL=https://zabbix.avansat.com.br
ZABBIX_API_TOKEN=

# A frequência efetiva depende da coleta dos itens no Zabbix
POLL_INTERVAL=25

# Coletor em serviço Docker independente; até 8 hosts por ciclo.
HOSTS_PER_CYCLE=8
# Mini-histórico local por 72h; histórico de 365 dias é consultado no Zabbix.
CACHE_RETENTION_HOURS=72

# App Web do Microsoft Entra para SMTP com OAuth no Microsoft 365.
SMTP_MICROSOFT_CLIENT_ID=
SMTP_MICROSOFT_CLIENT_SECRET=
SMTP_MICROSOFT_REDIRECT_URI=http://localhost:5000/smtp/microsoft/callback
